  "orc_raider": {
    "name": "Orc Raider",
    "sprite": "/assets/enemies/sprites/orc_raider.png",
    "source": "/assets/enemies/sources/orc_raider.png",
    "description": "A stocky moss-green raider with yellow eyes, ivory tusks, a short dark crest, worn asymmetrical leather and iron armor, a single spiked pauldron, bone trophies at the belt, and a broad notched crescent axe.",
    "animations": {
      "attack": "/assets/isometric/enemies/orc_raider-attack.png",
      "death": "/assets/isometric/enemies/orc_raider-death.png"
    }
  },
  "orc_berserker": {
    "name": "Orc Berserker",
    "sprite": "/assets/enemies/sprites/orc_berserker.png",
    "source": "/assets/enemies/sources/orc_berserker.png",
    "description": "A massive hunched berserker with olive-green skin, ember-red eyes, ivory tusks, a roaring scarred face, a short dark-red crest, patched rust-red leather, spiked iron plates, heavy wrappings, and an enormous chipped two-handed axe.",
    "animations": {
      "attack": "/assets/isometric/enemies/orc_berserker-attack.png",
      "death": "/assets/isometric/enemies/orc_berserker-death.png"
    }
  },
  "kobold_trapper": {
    "name": "Kobold Trapper",
    "sprite": "/assets/enemies/sprites/kobold_trapper.png",
    "source": "/assets/enemies/sources/kobold_trapper.png",
    "description": "A small wiry rust-red reptilian trapper with a long toothy snout, amber eye, backward dark head spines, a ragged hide hood, leather straps and pouches, a barbed dagger, a coiled snare rope, clawed feet, and a long counterbalancing tail.",
    "animations": {
      "attack": "/assets/isometric/enemies/kobold_trapper-attack.png",
      "death": "/assets/isometric/enemies/kobold_trapper-death.png"
    }
  },
  "kobold_sparkmage": {
    "name": "Kobold Sparkmage",
    "sprite": "/assets/enemies/sprites/kobold_sparkmage.png",
    "source": "/assets/enemies/sources/kobold_sparkmage.png",
    "description": "A small rust-red reptilian caster with a long toothy snout, backward head spines, cyan-glowing eyes, ragged brown leather mage robes, copper charms, clawed feet, a long tail, and blue-white electrical arcs crawling over both bare hands.",
    "animations": {
      "attack": "/assets/isometric/enemies/kobold_sparkmage-attack.png",
      "death": "/assets/isometric/enemies/kobold_sparkmage-death.png"
    }
  },
  "gnoll_hunter": {
    "name": "Gnoll Hunter",
    "sprite": "/assets/enemies/sprites/gnoll_hunter.png",
    "source": "/assets/enemies/sources/gnoll_hunter.png",
    "description": "A tall lean hyena humanoid with mottled ochre-brown fur, a dark bristled mane, pointed ears, an amber eye, a long fanged muzzle, crude rawhide and bone gear, a scratched round wooden shield, a dark-tipped hunting spear, and digitigrade clawed feet.",
    "animations": {
      "attack": "/assets/isometric/enemies/gnoll_hunter-attack.png",
      "death": "/assets/isometric/enemies/gnoll_hunter-death.png"
    }
  },
  "gnoll_bonecaller": {
    "name": "Gnoll Bonecaller",
    "sprite": "/assets/enemies/sprites/gnoll_bonecaller.png",
    "source": "/assets/enemies/sources/gnoll_bonecaller.png",
    "description": "A hunched ochre-brown hyena shaman with a dark bristled mane, long fanged muzzle, worn hide garments, tooth and bone amulets, digitigrade claws, a twisted skull-and-bone ritual focus, and sickly emerald spirit flame around both the focus and free hand.",
    "animations": {
      "attack": "/assets/isometric/enemies/gnoll_bonecaller-attack.png",
      "death": "/assets/isometric/enemies/gnoll_bonecaller-death.png"
    }
  },
