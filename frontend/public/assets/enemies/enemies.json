  "wight_knight": {
    "name": "Wight Knight",
    "sprite": "/assets/enemies/sprites/wight_knight.png",
    "source": "/assets/enemies/sources/wight_knight.png",
    "description": "A tall rigid undead knight enclosed in blackened blue-steel plate armor, with a pointed closed helm and violet eye slit, layered gorget and pauldrons, a clawed gauntlet, a shredded near-black purple cloak, and a broad spectral Graveblade with an icy cyan core and magenta-violet edges.",
    "animations": {
      "attack": "/assets/isometric/enemies/wight_knight-attack.png",
      "death": "/assets/isometric/enemies/wight_knight-death.png"
    }
  },
  "ghoul_stalker": {
    "name": "Ghoul Stalker",
    "sprite": "/assets/enemies/sprites/ghoul_stalker.png",
    "source": "/assets/enemies/sources/ghoul_stalker.png",
    "description": "A feral hunched undead predator with taut ash-gray cadaver skin, a scarred bald skull, sparse stringy black hair, pointed ears, glowing amber eyes, a broad fanged mouth, extremely long arms, oversized clawed hands and feet, bent legs, ragged brown burial wraps, and a decayed hide shroud.",
    "animations": {
      "attack": "/assets/isometric/enemies/ghoul_stalker-attack.png",
      "death": "/assets/isometric/enemies/ghoul_stalker-death.png"
    }
  },
  "zombie_brute": {
    "name": "Zombie Brute",
    "sprite": "/assets/enemies/sprites/zombie_brute.png",
    "source": "/assets/enemies/sources/zombie_brute.png",
    "description": "A colossal asymmetrical undead brute with leathery gray-brown cadaver skin, a scarred bald head, sparse dark hair, milky eyes, broken yellow teeth, swollen shoulders, enormous arms and fists, a ragged slate-blue tabard, torn brown trousers and wraps, a heavy belt, broken wrist chains, and massive bare feet.",
    "animations": {
      "attack": "/assets/isometric/enemies/zombie_brute-attack.png",
      "death": "/assets/isometric/enemies/zombie_brute-death.png"
    }
  },
  "shadow_imp": {
    "name": "Shadow Imp",
    "sprite": "/assets/enemies/sprites/shadow_imp.png",
    "source": "/assets/enemies/sources/shadow_imp.png",
    "description": "A small wiry fiend with near-black violet reptilian skin, tall ridged horns, long pointed ears, glowing magenta eyes, thin sharp teeth, elongated claws, a ragged bat wing, a curled tail, a torn brown loincloth, metal bands, and luminous purple shadow flame clinging to its body.",
    "animations": {
      "attack": "/assets/isometric/enemies/shadow_imp-attack.png",
      "death": "/assets/isometric/enemies/shadow_imp-death.png"
    }
  },
